<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions for a release build (tauri.release.conf.json). They're
     for the Node inside the app, which runs bloomd: V8 compiles JavaScript to machine code at
     run time. The SQLite addon needs no exception, since scripts/release.sh signs it with the
     same Developer ID. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- bloomd asks System Events which app is in front, to give focus back after a sign-in
       window (Info.plist says why). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
